[node name="TextureRect2" type="TextureRect" parent="MarginContainer/VBoxContainer/HBoxContainer2"]
layout_mode = 2
tooltip_text = "Value multiplied to non-Retro Zone timers.  For example,
a level with a 30 second timer will be set to 60 seconds
when the multiplier is 2.0 or 15 seconds with a multiplier
of 0.5.

To get PSX times on PC, set this to 0.67."
