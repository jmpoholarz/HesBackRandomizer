[node name="TextureRect" parent="MarginContainer/VBoxContainer/HBoxContainer" instance=ExtResource("1_qhw4f")]
layout_mode = 2
tooltip_text = "Vanilla - use the default timers set by the
base game.

Dynamic - adjust the timer for each level based
on the randomized start locations.  Results in
more time when starting on the edge of levels
and less when starting in the center."

